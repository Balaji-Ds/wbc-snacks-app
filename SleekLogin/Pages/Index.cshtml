@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (TempData["LoginMessage"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>@msg</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">Sleek Login Preview</h1>
    <p class="lead text-muted">Use the navigation to open the login page and try the demo credentials.</p>
    <a class="btn btn-primary btn-lg" asp-page="/Account/Login">Open Login</a>
</div>
